{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Root tests import the Deno edge handler, whose local imports carry the
    // .ts extension Deno requires; TS accepts them only with these two flags.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions",
    "web",
    "admin",
    "packages"
  ]
}
