# copy to scripts/sandbox/sandbox.env (git-ignored). Never put production values here.
TEST_REF=                    # sandbox project ref (NOT hqycwntpfoztoinemqns)
TEST_DB_URL=                 # postgresql://postgres.<ref>:<pw>@aws-0-us-west-2.pooler.supabase.com:5432/postgres  (owner-held)
TEST_ANON_KEY=               # sandbox anon (publishable) key
TEST_SERVICE_ROLE_KEY=       # sandbox service_role key — used ONLY for admin REST reads in the harness
INTERNAL_CRON_SECRET=        # same value set in the sandbox edge secrets
BUYER_EMAIL=  BUYER_PASSWORD=
SELLER_EMAIL= SELLER_PASSWORD=
U2_EMAIL=     U2_PASSWORD=
STRIPE_WEBHOOK_ENDPOINT_ID=  # we_… of the SANDBOX endpoint (for stripe events resend)
SANDBOX_OUT=./sandbox_out
