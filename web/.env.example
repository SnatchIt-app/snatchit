# Snatch It web — environment variables (NAMES ONLY — never commit values).
# Copy to .env.local for local dev; set the same names in Vercel for deploys.

# Supabase project URL and PUBLIC key (anon/publishable class only).
# NEVER put the service-role key in this app — it has no place in a Next.js
# bundle or server env for this phase; all privileged logic stays in Supabase
# edge functions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin for metadata/sitemaps (e.g. the Vercel preview URL).
NEXT_PUBLIC_SITE_URL=

# Optional — leave unset until a dedicated WEB Sentry project exists
# (the existing DSN belongs to the React Native project; do not reuse it).
# NEXT_PUBLIC_SENTRY_DSN=
