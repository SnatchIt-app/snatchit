# Public-class only. There is deliberately no service-role key in this app.
# NEXT_PUBLIC_SUPABASE_ANON_KEY: sb_publishable_… or the legacy anon JWT. env.ts refuses to start on an
# sb_secret_… key or a JWT whose role is not anon (service_role included).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# On a Vercel production deploy env.ts accepts only https://admin.snatchitapp.com, or
# https://snatchit-admin.vercel.app during the transition (no port, no credentials).
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Header badge: production | staging | local  (red when "production")
# "local" is a badge only: it never shows the "Sample data" notice. Only harness | rehearsal do, and
# only with NEXT_PUBLIC_SUPABASE_URL on localhost / 127.0.0.1 / ::1 (never on Vercel production/preview).
NEXT_PUBLIC_ENV_LABEL=local
