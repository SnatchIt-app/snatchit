{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck20150319",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::snatchit-audit-652872010073",
      "Condition": { "StringEquals": { "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:652872010073:trail/snatchit-audit-trail" } }
    },
    {
      "Sid": "AWSCloudTrailWrite20150319",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::snatchit-audit-652872010073/AWSLogs/652872010073/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:652872010073:trail/snatchit-audit-trail"
        }
      }
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [ "arn:aws:s3:::snatchit-audit-652872010073", "arn:aws:s3:::snatchit-audit-652872010073/*" ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyCeremonyAndVerifierFromMutatingAuditEvidence",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "arn:aws:iam::652872010073:role/SnatchIt-KMS-Ceremony",
          "arn:aws:iam::652872010073:user/snatchit-kms-verifier",
          "arn:aws:iam::652872010073:role/SnatchIt-CredentialSign-Runtime",
          "arn:aws:iam::652872010073:user/snatchit-credential-sign-runtime"
        ]
      },
      "Action": [
        "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutObject", "s3:DeleteBucket",
        "s3:PutBucketPolicy", "s3:DeleteBucketPolicy", "s3:PutLifecycleConfiguration",
        "s3:PutBucketVersioning", "s3:PutObjectRetention", "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention", "s3:PutEncryptionConfiguration",
        "s3:PutReplicationConfiguration", "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketPublicAccessBlock", "s3:PutBucketAcl", "s3:PutBucketOwnershipControls"
      ],
      "Resource": [ "arn:aws:s3:::snatchit-audit-652872010073", "arn:aws:s3:::snatchit-audit-652872010073/*" ]
    }
  ]
}
