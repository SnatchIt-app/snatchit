{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FounderAssumesCeremonyRoleWithMFA",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::[redacted: account id]:user/jose-admin" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "StringEquals": { "sts:RoleSessionName": "pfa18c-ceremony" }
      }
    }
  ]
}
