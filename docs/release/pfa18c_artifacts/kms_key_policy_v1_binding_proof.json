{
  "Version": "2012-10-17",
  "Id": "snatchit-ticket-signing-key-policy-v1-binding-proof",
  "Statement": [
    {
      "Sid": "AccountMayAdministerButNeverDelegateCryptoOps",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::[redacted: account id]:root" },
      "NotAction": [
        "kms:Sign", "kms:Verify", "kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:GenerateDataKeyPair",
        "kms:GenerateDataKeyPairWithoutPlaintext", "kms:GenerateDataKeyWithoutPlaintext", "kms:ReEncryptFrom",
        "kms:ReEncryptTo", "kms:DeriveSharedSecret", "kms:GenerateMac", "kms:VerifyMac"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CeremonyBindingProofSign_REMOVED_IN_V2",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::[redacted: account id]:role/SnatchIt-KMS-Ceremony" },
      "Action": "kms:Sign",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:SigningAlgorithm": "ECDSA_SHA_256" } }
    },
    {
      "Sid": "RuntimeSignOnly",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::[redacted: account id]:role/SnatchIt-CredentialSign-Runtime" },
      "Action": "kms:Sign",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:SigningAlgorithm": "ECDSA_SHA_256", "kms:MessageType": "RAW" } }
    },
    {
      "Sid": "VerifierAndCeremonyReadPublicKeyAndPolicy",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::[redacted: account id]:user/snatchit-kms-verifier",
          "arn:aws:iam::[redacted: account id]:role/SnatchIt-KMS-Ceremony"
        ]
      },
      "Action": [ "kms:DescribeKey", "kms:GetPublicKey", "kms:GetKeyPolicy", "kms:ListKeyPolicies", "kms:ListResourceTags" ],
      "Resource": "*"
    }
  ]
}
