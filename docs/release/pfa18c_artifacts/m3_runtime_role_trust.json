{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheRuntimeUserWithExternalId",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::[redacted: account id]:user/snatchit-credential-sign-runtime" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "sts:ExternalId": "<KMS_SIGNER_EXTERNAL_ID — generated by the founder, stored ONLY in Supabase secrets>" }
      }
    }
  ]
}
