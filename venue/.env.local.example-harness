# Copy to .env.local to run the venue dashboard in DATABASE mode against the
# local rehearsal harness (admin/scripts/local-stack.sh start snatchit_venue_rehears
# with LOCAL_STACK_SCHEMAS="public, kernel, ops, venue_api"). Names only; the
# harness prints its synthetic anon key when it starts. Never a service-role key.
NEXT_PUBLIC_VENUE_DATA_SOURCE=database
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3202
NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by local-stack.sh>
NEXT_PUBLIC_ENV_LABEL=rehearsal
